-- Q1.
-- Unified contact list of staff and customers

SELECT 
    CONCAT(first_name, ' ', last_name) AS full_name,
    email
FROM sales.staffs

UNION

SELECT 
    CONCAT(first_name, ' ', last_name) AS full_name,
    email
FROM sales.customers;



-- Q2.
-- States having BOTH stores and customers

SELECT state
FROM sales.stores

INTERSECT

SELECT state
FROM sales.customers;



-- Q3.
-- Stores with zero orders in 2018

SELECT store_id
FROM sales.stores

EXCEPT

SELECT DISTINCT store_id
FROM sales.orders
WHERE YEAR(order_date) = 2018;



